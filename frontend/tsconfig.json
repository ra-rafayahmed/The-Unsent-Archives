{
  // Same ratchet as the backend: a file is type-checked only once it carries a
  // `// @ts-check` pragma, so JSX components can be annotated incrementally
  // without converting the app to TypeScript.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  "include": ["src/**/*.js", "src/**/*.jsx"],
  "exclude": ["node_modules", "dist", "coverage", "src/**/*.test.js", "src/**/*.test.jsx"]
}
