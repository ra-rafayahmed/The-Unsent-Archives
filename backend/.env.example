# Copy to backend/.env and fill in. Never commit the real .env.

# Server
PORT=5000
NODE_ENV=development            # development | production | test
LOG_LEVEL=                      # optional: trace|debug|info|warn|error (defaults by NODE_ENV)

# MongoDB
# Local (docker compose):  mongodb://localhost:27017/unsent_archives
# Atlas:                   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/unsent_archives?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/unsent_archives

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of emails that are granted the admin role on registration
ADMIN_EMAILS=admin@example.com
