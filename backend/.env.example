# ─────────────────────────────────────────────────────────────────────────────
# Backend environment file for local Node development.
#   cp backend/.env.example backend/.env
# Running the stack with `docker compose up` instead? Use the root
# .env.example. Never commit a real .env — it is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# --- Server ---------------------------------------------------------------
PORT=5000
# development | production | test
NODE_ENV=development
# Optional pino level override: trace|debug|info|warn|error|fatal
# Defaults to debug in development, info in production, silent in tests.
LOG_LEVEL=

# --- Database (required) --------------------------------------------------
# Local mongod or `docker run -p 27017:27017 mongo:7`:
MONGODB_URI=mongodb://localhost:27017/unsent_archives
# Atlas alternative:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/unsent_archives?retryWrites=true&w=majority

# --- Auth (required) ------------------------------------------------------
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated emails granted the admin role when they register.
ADMIN_EMAILS=admin@example.com

# --- Tests (optional) -----------------------------------------------------
# `npm test` needs no database: mongodb-memory-server starts one in memory and
# tests/helpers/env.js sets NODE_ENV/JWT_SECRET/MONGODB_URI itself. Override
# only if you want the mongod binary cached somewhere specific (CI does this).
# MONGOMS_DOWNLOAD_DIR=../.mongodb-binaries
