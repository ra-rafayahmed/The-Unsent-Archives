# ─────────────────────────────────────────────────────────────────────────────
# Root environment file, read by `docker compose up`.
#   cp .env.example .env
# For running the backend directly with Node instead, use backend/.env
# (see backend/.env.example). Never commit a real .env — it is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# --- Server ---------------------------------------------------------------
# Port the API listens on inside its container (also published to the host).
PORT=5000
# development | production | test
NODE_ENV=production
# Optional pino level override: trace|debug|info|warn|error|fatal
LOG_LEVEL=info

# --- Database -------------------------------------------------------------
# Compose starts its own MongoDB and injects this value, so you normally do
# NOT need to set it here. Uncomment only to point the stack at an external
# database (e.g. Atlas) instead of the bundled `mongo` service.
# MONGODB_URI=mongodb://mongo:27017/unsent_archives

# --- Auth -----------------------------------------------------------------
# REQUIRED in any real deployment. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated emails granted the admin role when they register.
ADMIN_EMAILS=admin@example.com

# --- Host ports (compose only) --------------------------------------------
# Port the web UI is published on (the API uses PORT above).
WEB_PORT=8080

# --- Tests (optional) -----------------------------------------------------
# Where mongodb-memory-server caches its mongod binary. Defaults to
# backend/node_modules/.cache/mongodb-memory-server; CI overrides it so the
# download can be cached between runs. Not needed for normal development.
# MONGOMS_DOWNLOAD_DIR=./.mongodb-binaries
