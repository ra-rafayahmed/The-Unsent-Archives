# ─────────────────────────────────────────────────────────────────────────────
# Root environment file, read by `docker compose up`.
#   cp .env.example .env
# For running the backend directly with Node instead, use backend/.env
# (see backend/.env.example). Never commit a real .env — it is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# --- Server ---------------------------------------------------------------
# Port the API listens on inside its container (also published to the host).
PORT=5000
# development | production | test
NODE_ENV=production
# Optional pino level override: trace|debug|info|warn|error|fatal
LOG_LEVEL=info

# --- Database -------------------------------------------------------------
# Compose starts its own MongoDB reachable at this URI. Change it only to
# point the stack at an external database, e.g. Atlas:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/unsent_archives
MONGODB_URI=mongodb://mongo:27017/unsent_archives

# --- Auth -----------------------------------------------------------------
# REQUIRED in any real deployment. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated emails granted the admin role when they register.
ADMIN_EMAILS=admin@example.com

# --- Error reporting (optional) -------------------------------------------
# If set, unexpected 5xx errors and crashes are POSTed here as sanitised JSON.
ERROR_WEBHOOK_URL=

# --- Host ports (compose only) --------------------------------------------
# Port the web UI is published on (the API uses PORT above).
WEB_PORT=8080

# --- Tests (optional) -----------------------------------------------------
# Where mongodb-memory-server caches its mongod binary for `npm test`.
# Defaults to backend/node_modules/.cache/mongodb-memory-server; CI points it
# here so the ~100MB download is cached between runs. Unused by compose.
MONGOMS_DOWNLOAD_DIR=./.mongodb-binaries
