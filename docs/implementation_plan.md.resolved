## 6. Route Wiring

Each route file creates an `express.Router()`, applies the relevant middleware, and maps HTTP verbs to controller functions.

### Pattern:

```js
// routes/postRoutes.js
const router = require("express").Router();
const { auth } = require("../middleware/auth");
const { optionalAuth } = require("../middleware/optionalAuth");
const validate = require("../middleware/validate");
const { createPostSchema, updatePostSchema } = require("../validators/postValidator");
const ctrl = require("../controllers/postController");

router.post("/",           auth, validate(createPostSchema), ctrl.createPost);
router.get("/:id",         optionalAuth,                     ctrl.getPost);
router.put("/:id",         auth, validate(updatePostSchema), ctrl.updatePost);
router.delete("/:id",      auth,                             ctrl.deletePost);
router.post("/:id/repost", auth,                             ctrl.repost);

// Comments (nested under posts)
router.post("/:id/comments",              auth, ctrl.addComment);
router.delete("/:id/comments/:commentId", auth, ctrl.deleteComment);

// Reactions (nested under posts)
router.post("/:id/reactions",   auth, ctrl.addReaction);
router.delete("/:id/reactions", auth, ctrl.removeReaction);
router.get("/:id/reactions",              ctrl.getReactions);

module.exports = router;
```

### Mount Point — `routes/index.js`:

```js
const router = require("express").Router();

router.use("/auth",        require("./authRoutes"));
router.use("/users",       require("./userRoutes"));
router.use("/posts",       require("./postRoutes"));
router.use("/collections", require("./collectionRoutes"));
router.use("/tags",        require("./tagRoutes"));
router.use("/feed",        require("./feedRoutes"));
router.use("/search",      require("./searchRoutes"));
router.use("/analytics",   require("./analyticsRoutes"));

module.exports = router;
```

### Mount in `app.js`:

```js
app.use("/api", require("./routes"));
```

---

## 7. Middleware Stack

### 7.1 `auth.js` — JWT Authentication

```
Authorization: Bearer <JWT>
→ Decode with jsonwebtoken.verify()
→ Attach decoded payload to req.user = { id, username, email }
→ If invalid/expired → 401 Unauthorized
```

### 7.2 `optionalAuth.js` — Soft Auth

Same as `auth.js` but if no token is present, `req.user = null` and the request proceeds. Used on endpoints where authenticated users get extra data (e.g., seeing their own private posts in a feed).

### 7.3 `validate.js` — Joi Validation Factory

```js
const validate = (schema) => (req, res, next) => {
  const { error } = schema.validate(req.body, { abortEarly: false });
  if (error) return res.status(400).json({
    message: "Validation failed",
    details: error.details.map(d => d.message),
  });
  next();
};
```

### 7.4 `errorHandler.js` — Global Error Handler

Catches all unhandled errors from `asyncHandler`. Returns structured JSON:

```json
{
  "status": "error",
  "statusCode": 404,
  "message": "Post not found"
}
```

In development, includes `stack` trace. In production, hides stack.

### 7.5 `rateLimiter.js`

Uses `express-rate-limit`:
- Global: 100 requests / 15 min per IP
- Auth endpoints: 10 requests / 15 min per IP (brute-force protection)

### 7.6 `requestLogger.js`

Uses `morgan` in `dev` format during development, `combined` format in production. Logs method, path, status, and response time.

