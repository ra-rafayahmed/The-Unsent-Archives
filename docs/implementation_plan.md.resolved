## 4. Model Definitions

### 4.1 `User.js` — **New file (missing)**

This is the most critical gap. The schema should align with the ERD:

```js
const mongoose = require("mongoose");
const bcrypt = require("bcryptjs");

const userSchema = new mongoose.Schema(
  {
    username:     { type: String, required: true, unique: true, trim: true,
                    minlength: 3, maxlength: 30, match: /^[a-zA-Z0-9_]+$/ },
    email:        { type: String, required: true, unique: true, lowercase: true,
                    match: /^\S+@\S+\.\S+$/ },
    passwordHash: { type: String, required: true, select: false },
    avatarUrl:    { type: String, default: "" },
    bio:          { type: String, maxlength: 300, default: "" },
    isActive:     { type: Boolean, default: true },
    profile: {
      displayName: { type: String, maxlength: 50 },
      location:    { type: String, maxlength: 100 },
      website:     { type: String, maxlength: 200 },
    },
    tagInterests: [{ type: mongoose.Schema.Types.ObjectId, ref: "Tag" }],
  },
  { timestamps: true }
);

// Pre-save hook: hash password
userSchema.pre("save", async function (next) {
  if (!this.isModified("passwordHash")) return next();
  this.passwordHash = await bcrypt.hash(this.passwordHash, 12);
  next();
});

// Instance method: compare password
userSchema.methods.comparePassword = async function (candidate) {
  return bcrypt.compare(candidate, this.passwordHash);
};

userSchema.index({ username: "text", email: 1 });

module.exports = mongoose.model("User", userSchema);
```

### 4.2 Existing Models — No changes needed

All other models ([Post.js](file:///d:/University/Projects/ADBMS/The%20Unsent%20Archives/backend/models/Post.js), [Follow.js](file:///d:/University/Projects/ADBMS/The%20Unsent%20Archives/backend/models/Follow.js), [Reaction.js](file:///d:/University/Projects/ADBMS/The%20Unsent%20Archives/backend/models/Reaction.js), [Collection.js](file:///d:/University/Projects/ADBMS/The%20Unsent%20Archives/backend/models/Collection.js), [Tag.js](file:///d:/University/Projects/ADBMS/The%20Unsent%20Archives/backend/models/Tag.js), [AnalyticsEvent.js](file:///d:/University/Projects/ADBMS/The%20Unsent%20Archives/backend/models/AnalyticsEvent.js), [SearchIndex.js](file:///d:/University/Projects/ADBMS/The%20Unsent%20Archives/backend/models/SearchIndex.js)) are already complete with indexes and match the ERD. No modifications needed.

